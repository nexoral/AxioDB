{
  "name": "axiodb",
  "version": "24.35.0",
  "description": "Embedded NoSQL Database for TypeScript & AI Agents. Zero-native document database with ACID transactions & in-memory cache — verified on Node.js & Bun.",
  "main": "./lib/config/DB.js",
  "types": "./lib/config/DB.d.ts",
  "scripts": {
    "node-test": "node ./Test/node/run.js",
    "bun-test": "bun ./Test/bun/run.js",
    "test": "npm run node-test --",
    "benchmark": "node -e \"if (!require('fs').existsSync('./lib/config/DB.js')) require('child_process').execSync('npm run build', { stdio: 'inherit' });\" && node ./benchmark/run.js",
    "bun-benchmark": "bun ./benchmark/run.js",
    "build": "tsc",
    "lint": "eslint source/",
    "lint:fix": "eslint source/ --fix"
  },
  "keywords": [
    "axiodb",
    "ai-agent-database",
    "ai-agent-memory",
    "agentic-state-store",

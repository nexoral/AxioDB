{
  "name": "axiodb",
  "version": "22.28.3",
  "description": "Embedded NoSQL Database for TypeScript & AI Agents. Zero-native document database with ACID transactions & in-memory cache — verified on Node.js, Bun & Deno.",
  "main": "./lib/config/DB.js",
  "types": "./lib/config/DB.d.ts",
  "scripts": {
    "test": "node ./Test/run.js",
    "benchmark": "node -e \"if (!require('fs').existsSync('./lib/config/DB.js')) require('child_process').execSync('npm run build', { stdio: 'inherit' });\" && node ./benchmark/run.js",
    "build": "tsc",
    "lint": "eslint source/",
    "lint:fix": "eslint source/ --fix"
  },
  "keywords": [
    "axiodb",
    "ai-agent-memory",
    "agentic-state-store",
    "agent-memory",
    "ai-agent-database",
    "local-first",
    "local-first-database",
    "database",
    "nosql",
    "embedded-nosql",
    "embedded-database",
    "sqlite-alternative",
    "mongodb-queries",
    "file-database",
    "json-database",
    "nodejs",
    "bun",
    "deno",
    "bun-database",
    "deno-database",
    "typescript",
    "zero-dependencies",
    "no-native-bindings",
    "mcp-database",
    "model-context-protocol",
    "acid-transactions",
    "wal-transactions",
    "in-memory-cache",
    "caching",
    "schema-validation",
    "aggregation",
    "aggregation-pipeline",
    "bulk-operations",
    "worker-threads",
    "multi-core",
    "desktop-app",
    "cli-tool",
    "electron",
    "web-gui",
    "database-gui",
    "query-builder",
    "chainable-api",
    "fluent-api",
    "fast",
    "lightweight",
    "scalable",
    "production-ready",
    "developer-friendly",
    "open-source",
    "cross-platform"
  ],
  "author": "Ankan Saha",
  "license": "MIT",
  "homepage": "https://axiodb.in",
  "funding": {
    "type": "git",
    "url": "https://github.com/sponsors/AnkanSaha"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nexoral/AxioDB"
  },
  "dependencies": {
    "@fastify/multipart": "^9.0.3",
    "fastify": "^5.8.5"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "eslint": "^10.9.1",
    "selfsigned": "^5.5.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=6.0.0",
    "yarn": ">=1.0.0"
  }
